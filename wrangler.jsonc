{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bilimerge",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-22",
  "assets": {
    "directory": "./public",
    "run_worker_first": [
      "/merged-request.js",
      "/merged-response.js",
      "/bilimerge.sgmodule",
      "/bili-adblock.sgmodule"
    ]
  }
}
